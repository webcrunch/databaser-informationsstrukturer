# Lösenorden för docker-compose.prod.yml. På servern skriver deployen .env från Vault
# (kv/databases, en nyckel per rad nedan). Lokalt: kopiera till .env och fyll i.
# Undvik ' (enkelfnutt) i lösenorden: värdena skrivs inom enkelfnuttar i .env.
POSTGRES_PASSWORD=
PGADMIN_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
TRAVEL_AGENT_PASSWORD=
PROJECT_B_ROOT_PASSWORD=
PROJECT_B_PASSWORD=
# Låset framför jarllindquist.com/adminer: "användare:bcrypt-hash", t.ex. från
#   docker run --rm httpd:2.4-alpine htpasswd -nbB jarl 'ett-långt-lösenord'
# Hashen innehåller $, och det är rätt: värdet skrivs inom enkelfnuttar i .env.
ADMINER_BASIC_AUTH=
